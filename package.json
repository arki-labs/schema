{
  "name": "@arki/schema",
  "version": "0.3.3",
  "description": "Standard Schema for every validator: the spec types, a sync and an async parse that return typed failures, issue paths and messages, and a JSON Schema bridge. Works with Zod, Valibot, ArkType or a hand-written schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "schema",
    "standard-schema",
    "validation",
    "zod",
    "valibot",
    "arktype",
    "json-schema"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.ts",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**",
    "docs/**",
    "llms.txt",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@arki/failure": "0.4.2",
    "@standard-schema/spec": "^1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "arki": {
    "runtimes": [
      "node",
      "bun",
      "deno",
      "browser",
      "hermes"
    ]
  }
}
